# Copiar a .env (sin el .example) y completar. .env nunca se commitea.

# Mailchimp → Cuenta → Extras → API keys → Create A Key.
# Tiene forma "<32 caracteres>-usNN": el sufijo después del guión (ej. us21)
# es el prefijo de servidor, el script lo saca solo.
MAILCHIMP_API_KEY=

# EmailOctopus → Cuenta → Integrations & API → API Keys → Create an API Key.
EMAILOCTOPUS_API_KEY=
